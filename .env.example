# Copy to .env.local for local development, and add the same values in Vercel → Settings → Environment Variables.

# Your site's public URL (no trailing slash). Used for Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secret: server only

# Stripe → Developers → API keys, and the Pro price you create in Products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Claude API key (console.anthropic.com). Powers photo tagging, outfit suggestions and reviews.
ANTHROPIC_API_KEY=
# Optional: model override. Default is claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Affiliate revenue (all optional; links still work without them but earn nothing)
AMAZON_ASSOCIATE_TAG=               # e.g. yourtag-20 from Amazon Associates
SKIMLINKS_PUBLISHER_ID=             # e.g. 123456X789012, makes Nordstrom/Uniqlo/J.Crew links earn
SOVRN_API_KEY=                      # alternative to Skimlinks; used only if Skimlinks is not set

# Comma-separated emails that can open /admin (subscribers, AI cost, affiliate clicks)
ADMIN_EMAILS=
